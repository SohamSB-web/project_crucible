# ============================================================
# Hackathon 2026 Backend — Environment Variables
# Copy this file to .env and fill in your actual values.
# ============================================================

# --- Neon PostgreSQL ---
# Get from: https://console.neon.tech → your project → Connection Details
# Use the "Pooled connection" string for DATABASE_URL (required for Vercel serverless)
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"

# Use the "Direct connection" string for DIRECT_URL (required for Prisma migrations)
DIRECT_URL="postgresql://user:password@host/neondb?sslmode=require"

# --- JWT ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace-with-a-random-secret"
JWT_EXPIRES_IN="7d"

# --- Resend (Transactional Email) ---
# Get from: https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# --- SMTP email (preferred) ---
# For Gmail, enable 2FA and create an App Password. Do not use your normal password.
EMAIL_TRANSPORT="smtp"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="parabkesarp20@gmail.com"
SMTP_PASS="eubp zfjm syba hgud"
EMAIL_FROM="Mission Crucible <admin@crusible.dev>"

# --- Supabase Storage for participant ID proofs & Payments ---
IDS_SUPABASE_URL="https://your-id-storage-project.supabase.co"
IDS_SUPABASE_SERVICE_KEY="your-id-storage-service-role-key"
IDS_SUPABASE_BUCKET="hackathon-submissions"

PAYMENTS_SUPABASE_URL="https://your-payment-storage-project.supabase.co"
PAYMENTS_SUPABASE_SERVICE_KEY="your-payment-storage-service-role-key"
PAYMENTS_SUPABASE_BUCKET="PAYMENTS"

# --- Cloudflare R2 submission storage ---
# Create an R2 API token at https://dash.cloudflare.com -> R2 -> Manage R2 API Tokens
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_R2_ACCESS_KEY_ID="your-32-character-r2-access-key-id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your-64-character-r2-secret-access-key"
CLOUDFLARE_R2_BUCKET="hackathon-submissions"

# --- Upstash Redis (Rate Limiting) ---
# Get from: https://console.upstash.com → Redis → your db → REST API
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"


# --- Cloudflare Turnstile ---
# Get from: https://dash.cloudflare.com → Turnstile → your site → Secret key
TURNSTILE_SECRET_KEY="your-turnstile-secret"

# --- Server & Frontend URLs ---
PORT=4000
FRONTEND_URL="https://your-frontend.vercel.app"
# Comma-separated list of allowed frontend origins (supports *.vercel.app automatically)
CORS_ORIGINS="http://localhost:5173,https://your-frontend.vercel.app"

# --- Feature Flags ---
# Set to "true" to disable Turnstile verification during local dev
SKIP_TURNSTILE="true"
