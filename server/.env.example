# ============================================================
# Hackathon 2026 Backend — Environment Variables
# Copy this file to .env and fill in your actual values.
# ============================================================

# --- Neon PostgreSQL ---
# Get from: https://console.neon.tech → your project → Connection Details
# Use the "Pooled connection" string for DATABASE_URL (required for Vercel serverless)
DATABASE_URL="postgresql://user:password@ep-xxx.pooler.neon.tech/neondb?pgbouncer=true&connect_timeout=15&sslmode=require"

# Use the "Direct connection" string for DIRECT_URL (required for Prisma migrations)
DIRECT_URL="postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require"

# --- JWT ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace-with-a-64-char-random-hex-string"
JWT_EXPIRES_IN="7d"

# --- Resend (Transactional Email) ---
# Get from: https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="Hackathon 2026 <noreply@yourdomain.com>"

# --- Supabase Storage ---
# Get from: https://supabase.com → your project → Settings → API
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
SUPABASE_SERVICE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxx"
# The name of the private storage bucket you create in Supabase
SUPABASE_BUCKET="hackathon-submissions"


PAYMENTS_SUPABASE_URL=
PAYMENTS_SUPABASE_SERVICE_KEY=
IDS_SUPABASE_BUCKET=
# --- Upstash Redis (Rate Limiting) ---
# Get from: https://console.upstash.com → Redis → your db → REST API
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="AXxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# --- Cloudflare Turnstile ---
# Get from: https://dash.cloudflare.com → Turnstile → your site → Secret key
TURNSTILE_SECRET_KEY="0x4AAAAAAA_xxxxxxxxxxxxxxxxxx"

# --- Server ---
PORT=4000
# Comma-separated list of allowed frontend origins
CORS_ORIGINS="http://localhost:5173,https://your-frontend.vercel.app"

# --- Feature Flags ---
# Set to "true" to disable Turnstile verification during local dev
SKIP_TURNSTILE="true"
