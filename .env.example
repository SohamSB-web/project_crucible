# ============================================================
# Hackathon 2026 Backend — Environment Variables
# Copy this file to .env and fill in your actual values.
# ============================================================

# --- Neon PostgreSQL ---
# Get from: https://console.neon.tech → your project → Connection Details
# Use the "Pooled connection" string for DATABASE_URL (required for Vercel serverless)
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"

# Use the "Direct connection" string for DIRECT_URL (required for Prisma migrations)
DIRECT_URL="postgresql://user:password@host/neondb?sslmode=require"

# --- JWT ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace-with-a-random-secret"
JWT_EXPIRES_IN="7d"

# --- Resend (Transactional Email) ---
# Get from: https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="Hackathon 2026 <noreply@yourdomain.com>"

#for ids and payment ss
PAYMENTS_SUPABASE_URL="https://uwwmnjvslygomjetguiu.supabase.co"
PAYMENTS_SUPABASE_SERVICE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InV3d21uanZzbHlnb21qZXRndWl1Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4ODM0NDUxMSwiZXhwIjoyMTAzOTIwNTExfQ.AAq_AjVYXbC2W1br54D71egM9UV1-DrbCaxBh9LGSuY"
