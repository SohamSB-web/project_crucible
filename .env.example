# --- Supabase Storage ---
# Get from: https://supabase.com → your project → Settings → API
SUPABASE_URL="https://brsrtgxexnaylqcihlzr.supabase.co"
SUPABASE_SERVICE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJyc3J0Z3hleG5heWxxY2lobHpyIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4ODE3OTM5NCwiZXhwIjoyMTAzNzU1Mzk0fQ.uqhRMfKJQEKkvegqiUzLSbXRqy1zt8xBWVTsAXcR62U"
# The name of the private storage bucket you create in Supabase
SUPABASE_BUCKET="hackathon-submissions"

# --- Upstash Redis (Rate Limiting) ---
# Get from: https://console.upstash.com → Redis → your db → REST API
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"


# --- Cloudflare Turnstile ---
# Get from: https://dash.cloudflare.com → Turnstile → your site → Secret key
TURNSTILE_SECRET_KEY="your-turnstile-secret"

# --- Server ---
PORT=4000
# Comma-separated list of allowed frontend origins
CORS_ORIGINS="http://localhost:5173,https://your-frontend.vercel.app"

# --- Feature Flags ---
# Set to "true" to disable Turnstile verification during local dev
SKIP_TURNSTILE="true"
