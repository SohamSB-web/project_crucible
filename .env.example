# ============================================================
# Project Crucible Frontend — Environment Variables
# Copy this file to .env and fill in your actual values.
# ============================================================

# Backend API URL (for local dev: http://localhost:4000, for Vercel prod: https://your-backend.onrender.com)
VITE_API_BASE_URL="http://localhost:4000"

# Cloudflare Turnstile Site Key (public key)
# For local dev / testing, use Cloudflare's always-pass test key: 1x00000000000000000000AA
# For production, obtain from Cloudflare Turnstile dashboard
VITE_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
